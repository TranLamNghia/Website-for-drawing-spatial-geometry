# Shared internal API key (backend <-> ai_service <-> math_sandbox <-> frontend google-exchange)
INTERNAL_API_KEY=

# Vertex / Gemini (ai_service)
VERTEX_GEMINI_APIKEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# Backend MongoDB
PROD_MONGODB_CONNECTION_STRING=mongodb://localhost:27017
PROD_MONGODB_DATABASE_NAME=SpaticalGeometryDB

# Frontend public API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Backend JWT ---
# openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=SpatialGeometry
JWT_AUDIENCE=SpatialGeometry
JWT_EXPIRES_MINUTES=10080

# --- Google Sign-In (Auth.js / NextAuth) ---
# Create OAuth Web Client in Google Cloud Console:
#   Authorized redirect URIs:
#     http://localhost:3000/api/auth/callback/google
#     https://vehinhkhongkho.com/api/auth/callback/google
# Authorized domain (consent screen): vehinhkhongkho.com
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP (cPanel — feedback + OTP registration email) ---
SMTP_HOST=mail.vehinhkhongkho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vehinhkhongkho.com
SMTP_PASS=
MAIL_FROM=noreply@vehinhkhongkho.com
MAIL_FROM_NAME=SpatialGeometry

# Feedback storage (Airtable + Cloudinary)
AIRTABLE_TOKEN_ID=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Report
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
