# Shared internal API key (backend <-> ai_service <-> math_sandbox <-> frontend sync-user)
INTERNAL_API_KEY=

# Vertex / Gemini (ai_service)
VERTEX_GEMINI_APIKEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# Backend MongoDB
PROD_MONGODB_CONNECTION_STRING=mongodb://localhost:27017

# Frontend public API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Google Sign-In (Auth.js / NextAuth) ---
# Create OAuth Web Client in Google Cloud Console:
#   Authorized redirect URIs:
#     http://localhost:3000/api/auth/callback/google
#     https://vehinhkhongkho.com/api/auth/callback/google
# Authorized domain (consent screen): vehinhkhongkho.com
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail API (feedback confirmation email) ---
# Enable Gmail API, obtain a refresh token with scope:
#   https://www.googleapis.com/auth/gmail.send
# Use the sender Gmail account (personal accounts need refresh token, not service account).
GMAIL_SENDER_EMAIL=
GMAIL_REFRESH_TOKEN=

# Feedback storage (Airtable + Cloudinary)
AIRTABLE_TOKEN_ID=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Report
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
